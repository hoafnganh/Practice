S.<x> = PolynomialRing(ZZ)
from Crypto.Util.number import *
poly = sum(e * x ^ i for i, e in enumerate(n.digits(2)))
print(poly)
print(poly.factor())
poly_p = x^511 + x^494 + x^445 + x^359 + x^320 + x^49 + 1
poly_q = x^513 + x^348 + x^327 + x^313 + x^249 + x^212 + 1
p = poly_p(x = 2)
q = poly_q(x = 2)
phi = (p - 1) * (q - 1)
d = pow(e, -1, phi)
print(long_to_bytes(pow(c, d, n)))
