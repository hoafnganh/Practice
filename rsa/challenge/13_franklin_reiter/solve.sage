from Crypto.Util.number import *

n = 
e = 3
c1 = 7210636213144447762054767558018950157286470840314496988858814439128796811292994164808257248811607467671950553568079362511756427580885045743204846229179920535379562144626449367216248301167058855197926618801299932561537344917024315888298005081094132913221402625
c2 = 7210636213144447762054767558018950157286470840314496988858814439128796811292994164808369219318673690320316080337537783175153471645965476829061053003268963853446080617936575077129254698740932729539864917010733610921485523247994944513896187852279484967506935816

R.<x> = PolynomialRing(Zmod(n)) 
f = x - 1
g1 = f ^ e - c1
g2 = x ^ e - c2

def polynomial_gcd(a, b):
    while b != 0:
        a, b = b, a % b
    return a.monic()

g = polynomial_gcd(g1, g2)
print(type(g))
M2 = int(-g[0])
M1 = M2 - 1
print(long_to_bytes(M2))