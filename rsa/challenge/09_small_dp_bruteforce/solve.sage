from Crypto.Util.number import *
import math

n = 
e = 2999106977329972455050078816584118183037253984928077441615120778788038648167302547642065226142323717256088091407752330655537042682119679666279560787093079
c = 

r = 123456789 # random
dp = 1
# while True:
#     print("dp =", dp)
#     f = math.gcd(pow(r, e * dp, n) - r, n)
#     if f > 1:
