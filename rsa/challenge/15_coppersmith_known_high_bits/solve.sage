from Crypto.Util.number import *

n = 10760312199786264902023917914831811725987130022560023569508771823303326176223313404722681905139666740173638523827012519874704107555650376111974274170889697
e = 65537
p_high = 1356242464438363165485566072734093521457679
c = 7572586987247705069183845754369810708313748588233814885124746995242012690890291941595755571876927583611874491228215364082112516196257334957134826696575995


k = 116
X = 2 ^ k
p = p_high << k
R.<x> = PolynomialRing(Zmod(n))

f = x + p
roots = f.small_roots(X=X, beta=0.5, epsilon=0.02) # [34217079037357970097742928986372959]
p = p + Integer(roots[0])
q = n // p
assert n == p * q
phi = (p - 1) * (q - 1)
d = pow(e, -1, phi)
print(long_to_bytes(pow(c, d, n)))