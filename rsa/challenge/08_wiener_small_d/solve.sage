def cf(tu, mau):
    res = []
    h1, h2, k1, k2 = 1, 0, 0, 1
    a, b = tu, mau
    while b:
        q = a // b
        a, b = b, a % b
        h2, h1 = h1, q * h1 + h2
        k2, k1 = k1, q * k1 + k2
        res.append((h1, k1))
    return res

def wiener(n, e):
    for k, d in cf(e, n):
        if k == 0 or d == 0: continue
        if (e * d - 1) % k: continue
        phi = (e * d - 1) // k
        s = n - phi + 1
        if s <= 0: continue
        delta = s * s - 4 * n
        if delta < 0: continue
        r = math.isqrt(delta)
        if r * r != delta: continue
        p = (s + r) // 2
        q = (s - r) // 2
        if p * q == n:
            return d, p, q
        return None


d1, p, q = wiener(n, e)
print(d1)