from Crypto.Util.number import *

import gmpy2

n = 
e = 5
d = 
e_boss = 65537
c_boss = 

# ed = 1 mod phi --> ed = 1 + phi * k
# phi < n -> (ed - 1) / phi > (ed - 1) / n, lấy k bằng vế phải rồi tăng dần
k = (e * d - 1) // n
while True:
    phi = (e * d - 1) // k
    if phi * k == e * d - 1:
        break
    k += 1
d_boss = pow(e_boss, -1, phi)
print(long_to_bytes(pow(c_boss, d_boss, n)))