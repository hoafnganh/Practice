from Crypto.Util.number import *

n = 9119909759640093652786280732213806200174628236032231075786283859523215793919210152000157529852696844649232224075690248407390921720099155033014949945097231
e = 65537
c = 2694583216366332306138206449298223065936624188583182542423675067034789732067367822111538614644033008919163979934818787659380782820164559926107408538279490

a = 2
B = 10
found = False
while B < 10000000:
    for i in range(1, B + 1):
        a = pow(a, i, n)
        if i % 64 == 0:
            g = math.gcd(a - 1, n)
            if 1 < g < n:
                p = g
                found = True
                break
    if found:
        break
    B *= 2
print(p) # 2488079167766931167101186623163512762422465164170536656164709795673194048751
q = n // p
phi = (p - 1) * (q - 1)
d = pow(e, -1, phi)
print(long_to_bytes(pow(c, d, n)))


