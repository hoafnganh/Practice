from Crypto.Util.number import *
import gmpy2
n = 
e = 65537
c = 


a = gmpy2.isqrt(n)
if a * a < n: a += 1
while True:
    b2 = a * a - n
    b = gmpy2.isqrt(b2)
    if b * b == b2: break
    a += 1
p, q = a - b, a + b
print(p, q)
phi = (p - 1) * (q - 1)
d = pow(e, -1, phi)
print(d)
print(long_to_bytes(pow(c, d, n)).decode())