from Crypto.Util.number import *

M = [m0, m1, m2, m3, m4, m5, m6, m7]
S = [s0, s1, s2, s3, s4, s5, s6, s7]
P = set()
for i in range(8):
    p = gcd(pow(S[i], e, n) - M[i], n)
    # P.add(p)
# print(*P)
q = n // p
phi = (p - 1) * (q - 1)
d = pow(e, -1, phi)
print(long_to_bytes(pow(c, d, n)))